<Page
    x:Class="MusicPlayerWin.App.Views.RecentlyAddedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,28,32,110">
        <StackPanel Spacing="18">
            <TextBlock Text="Recently Added" FontSize="34" FontWeight="SemiBold" />
            <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Grid.Column="0" />
                            <TextBlock Text="{Binding Artist}" Grid.Column="1" Foreground="{ThemeResource SubtleBrush}" />
                            <TextBlock Text="{Binding Tracks.Count, FallbackValue=0}" Grid.Column="2" Foreground="{ThemeResource SubtleBrush}" />
                            <TextBlock Text="{Binding AddedAt}" Grid.Column="3" Foreground="{ThemeResource SubtleBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Text="No recently added tracks." Foreground="{ThemeResource SubtleBrush}" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
