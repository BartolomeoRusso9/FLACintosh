<Page
    x:Class="MusicPlayerWin.App.Views.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="36,30,36,120">
        <StackPanel Spacing="20">
            <Button Content="‹ Back" Click="Back_Click" HorizontalAlignment="Left" />
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="220" Height="220" CornerRadius="16" Background="#303035">
                    <Image x:Name="Artwork" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Album" Foreground="{ThemeResource SubtleBrush}" />
                    <TextBlock x:Name="Title" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="Artist" FontSize="20" Foreground="{ThemeResource SubtleBrush}" />
                    <TextBlock x:Name="Meta" Foreground="{ThemeResource SubtleBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                        <Button Content="Play" Click="Play_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Shuffle" Click="Shuffle_Click" />
                        <Button Content="Download offline" Click="Download_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <ListView x:Name="TracksList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Track_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TrackNumber}" Foreground="{ThemeResource SubtleBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SubtleBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="{ThemeResource SubtleBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
