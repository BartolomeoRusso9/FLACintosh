<Page
    x:Class="MusicPlayerWin.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,28,32,110">
        <StackPanel Spacing="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Playlists" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock Text="Your playlists and the playlists published by your music servers." Foreground="{ThemeResource SubtleBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="New playlist" Click="Create_Click" VerticalAlignment="Bottom" />
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Text="On this PC" FontSize="22" FontWeight="SemiBold" />
                <ListView x:Name="PlaylistsList" IsItemClickEnabled="True" ItemClick="Playlist_Click" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Entries.Count, FallbackValue=0}" Foreground="{ThemeResource SubtleBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Play" Click="Play_Click" Margin="12,0" />
                                <Button Grid.Column="2" Content="Delete" Click="Delete_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyState" Text="No local playlists yet." Foreground="{ThemeResource SubtleBrush}" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="From servers" FontSize="22" FontWeight="SemiBold" />
                <ListView x:Name="ServerPlaylistsList" IsItemClickEnabled="True" ItemClick="ServerPlaylist_Click" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerName}" Foreground="{ThemeResource SubtleBrush}" />
                                    <TextBlock Text="{Binding TrackUrls.Count, FallbackValue=0}" Foreground="{ThemeResource SubtleBrush}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyServerState" Text="No server playlists available." Foreground="{ThemeResource SubtleBrush}" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
