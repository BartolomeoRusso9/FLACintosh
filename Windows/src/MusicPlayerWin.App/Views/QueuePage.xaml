<Page
    x:Class="MusicPlayerWin.App.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,28,32,120">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Queue" FontSize="34" FontWeight="SemiBold" />
                <TextBlock x:Name="Summary" Foreground="{ThemeResource SubtleBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Save as playlist" Click="SavePlaylist_Click"/><Button Content="Clear up next" Click="Clear_Click" VerticalAlignment="Center" /></StackPanel>
        </Grid>
        <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Queue_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Position}" Foreground="{ThemeResource SubtleBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Track.Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Track.Artist}" Foreground="{ThemeResource SubtleBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Track.Album}" Foreground="{ThemeResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Track.Duration}" Foreground="{ThemeResource SubtleBrush}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal"><Button Content="↑" Tag="{Binding QueueIndex}" Click="MoveUp_Click" Margin="2,0"/><Button Content="↓" Tag="{Binding QueueIndex}" Click="MoveDown_Click" Margin="2,0"/></StackPanel>
                        <Button Grid.Column="5" Content="Remove" Tag="{Binding QueueIndex}" Click="Remove_Click" Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
