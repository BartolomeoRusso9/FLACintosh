<Page
    x:Class="MusicPlayerWin.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,28,32,110">
        <StackPanel Spacing="18">
            <StackPanel>
                <TextBlock Text="Downloaded" FontSize="34" FontWeight="SemiBold" />
                <TextBlock x:Name="Summary" Foreground="{ThemeResource SubtleBrush}" />
            </StackPanel>
            <ListView x:Name="ActiveDownloadsList" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SubtleBrush}"/>
                                <ProgressBar Minimum="0" Maximum="{Binding Total}" Value="{Binding Done}"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="{ThemeResource SubtleBrush}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView x:Name="DownloadsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SubtleBrush}" />
                                <TextBlock Text="{Binding Tracks.Count, FallbackValue=0}" Foreground="{ThemeResource SubtleBrush}" FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Play" Click="Play_Click" />
                                <Button Content="Remove" Click="Remove_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Text="No downloaded albums. Download a remote album from the Albums page." Foreground="{ThemeResource SubtleBrush}" Visibility="Collapsed" />
            <Button Content="Remove all downloads" Click="RemoveAll_Click" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Page>
