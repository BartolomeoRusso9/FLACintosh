<Page
    x:Class="MusicPlayerWin.App.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayerWin.App.Controls">
    <Grid x:Name="RootGrid" Padding="42,30,42,118">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*" />
            <ColumnDefinition Width="1.05*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="430" Height="430" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Border Background="#2A2A2D" CornerRadius="20">
                <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
            </Border>
            <MediaPlayerElement x:Name="CanvasPlayer" AreTransportControlsEnabled="False" Visibility="Collapsed" Stretch="UniformToFill" />
        </Grid>

        <StackPanel Grid.Column="1" Margin="42,12,0,0" Spacing="12">
            <TextBlock Text="Now Playing" Foreground="{ThemeResource SubtleBrush}" />
            <TextBlock x:Name="Title" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Artist" FontSize="20" Foreground="{ThemeResource SubtleBrush}" />
            <TextBlock x:Name="Album" FontSize="16" Foreground="{ThemeResource SubtleBrush}" />
            <TextBlock x:Name="LyricsSource" FontSize="12" Foreground="{ThemeResource SubtleBrush}" />
            <TextBlock x:Name="CanvasSource" FontSize="12" Foreground="{ThemeResource SubtleBrush}" />
            <ScrollViewer x:Name="LyricsScroller" Margin="0,14,0,0" Height="300">
                <StackPanel x:Name="LyricsPanel" Spacing="9" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
