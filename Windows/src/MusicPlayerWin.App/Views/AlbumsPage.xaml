<Page
    x:Class="MusicPlayerWin.App.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,28,32,110">
        <StackPanel Spacing="18">
            <TextBlock Text="Albums" FontSize="34" FontWeight="SemiBold" />
            <GridView x:Name="AlbumsGrid" IsItemClickEnabled="True" ItemClick="AlbumsGrid_ItemClick" SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="6" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="190" Margin="0,0,18,24" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="10">
                                <Border Height="160" Background="#303035" CornerRadius="10">
                                    <Image Stretch="UniformToFill" Loaded="AlbumArtwork_Loaded" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Tracks.Count, FallbackValue=0}" Foreground="{ThemeResource SubtleBrush}" FontSize="12" />
                                <Button Content="Download offline" Click="Download_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock x:Name="EmptyState" Text="No albums in the current library." Foreground="{ThemeResource SubtleBrush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
