<Page
    x:Class="MusicPlayerWin.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,28,32,120">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Title" FontSize="34" FontWeight="SemiBold" />
                <TextBlock x:Name="Summary" Foreground="{ThemeResource SubtleBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Play" Click="Play_Click"/>
                <Button Content="Add current queue" Click="AddQueue_Click"/>
                <Button Content="Rename" Click="Rename_Click"/>
                <Button Content="Delete" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
        <ListView x:Name="Tracks" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Position}" Foreground="{ThemeResource SubtleBrush}"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Entry.Artist}" Foreground="{ThemeResource SubtleBrush}"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Entry.Album}" Foreground="{ThemeResource SubtleBrush}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="↑" Tag="{Binding Index}" Click="Up_Click" Margin="2,0"/><Button Content="↓" Tag="{Binding Index}" Click="Down_Click" Margin="2,0"/></StackPanel>
                        <Button Grid.Column="4" Content="Remove" Tag="{Binding Index}" Click="Remove_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
