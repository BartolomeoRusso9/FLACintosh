<Page
    x:Class="MusicPlayerWin.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,28,32,110">
        <StackPanel Spacing="22">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Recap" FontSize="34" FontWeight="SemiBold" />
                    <ComboBox x:Name="PeriodCombo" Grid.Column="1" SelectionChanged="PeriodCombo_SelectionChanged" VerticalAlignment="Bottom">
                        <ComboBoxItem Content="Last 30 Days"/>
                        <ComboBoxItem Content="This Year"/>
                        <ComboBoxItem Content="All Time"/>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Clear history" Click="ClearHistory_Click" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock x:Name="Summary" Foreground="{ThemeResource SubtleBrush}" />
            </StackPanel>

            <Border x:Name="HeroCard" Background="{ThemeResource BrandGradientBrush}" CornerRadius="18" Padding="24" MinHeight="150">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="HeroSubtitle" FontSize="13" FontWeight="SemiBold" Foreground="#D9FFFFFF" />
                    <TextBlock x:Name="HeroMinutes" FontSize="48" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="minutes listened" FontSize="15" FontWeight="SemiBold" Foreground="#E6FFFFFF" />
                    <TextBlock x:Name="HeroCounts" FontSize="12" Foreground="#BFFFFFFF" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Grid x:Name="StreakBusiestGrid" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="6"><TextBlock x:Name="StreakTitle" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="StreakDetail" FontSize="12" Foreground="{ThemeResource SubtleBrush}" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="6"><TextBlock x:Name="BusiestTitle" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="BusiestDetail" FontSize="12" Foreground="{ThemeResource SubtleBrush}" TextWrapping="Wrap"/></StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="TopListsGrid" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel><TextBlock Text="Top artists" FontSize="18" FontWeight="SemiBold"/><ListView x:Name="ArtistsList" SelectionMode="None"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Top albums" FontSize="18" FontWeight="SemiBold"/>
                        <ListView x:Name="AlbumsList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                        <Border Width="34" Height="34" CornerRadius="4" Background="{ThemeResource PlaceholderBrush}">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PlaysLabel}" FontSize="11" Foreground="{ThemeResource SubtleBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel><TextBlock Text="Top tracks (double-click to play)" FontSize="18" FontWeight="SemiBold"/><ListView x:Name="TracksList" SelectionMode="None" IsItemClickEnabled="True" DoubleTapped="TracksList_DoubleTapped"/></StackPanel>
                </Border>
            </Grid>

            <Border x:Name="HourlyClockCard" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="When you listen" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel x:Name="HourlyClock" Orientation="Horizontal" Height="110" VerticalAlignment="Bottom" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Last 30 days" FontSize="20" FontWeight="SemiBold" />
                    <ListView x:Name="DailyList" SelectionMode="None" MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="7,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateLabel}"/>
                                    <ProgressBar Grid.Column="1" Maximum="300" Value="{Binding Minutes}" Margin="10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MinutesLabel}" Foreground="{ThemeResource SubtleBrush}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <TextBlock Text="Recent listening" FontSize="22" FontWeight="SemiBold" />
            <ListView x:Name="RecentList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SubtleBrush}"/></StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding HeardSeconds}" Foreground="{ThemeResource SubtleBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
