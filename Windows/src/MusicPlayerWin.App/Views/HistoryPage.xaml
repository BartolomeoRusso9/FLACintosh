<Page
    x:Class="MusicPlayerWin.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,28,32,110">
        <StackPanel Spacing="22">
            <StackPanel Spacing="4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recap" FontSize="34" FontWeight="SemiBold" /><Button Grid.Column="1" Content="Clear history" Click="ClearHistory_Click" /></Grid>
                <TextBlock x:Name="Summary" Foreground="{ThemeResource SubtleBrush}" />
            </StackPanel>
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel><TextBlock Text="Top artists" FontSize="18" FontWeight="SemiBold"/><ListView x:Name="ArtistsList" SelectionMode="None"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel><TextBlock Text="Top albums" FontSize="18" FontWeight="SemiBold"/><ListView x:Name="AlbumsList" SelectionMode="None"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                    <StackPanel><TextBlock Text="Top tracks" FontSize="18" FontWeight="SemiBold"/><ListView x:Name="TracksList" SelectionMode="None"/></StackPanel>
                </Border>
            </Grid>
            <Border Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Last 30 days" FontSize="20" FontWeight="SemiBold" />
                    <ListView x:Name="DailyList" SelectionMode="None" MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="7,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateLabel}"/>
                                    <ProgressBar Grid.Column="1" Maximum="300" Value="{Binding Minutes}" Margin="10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Minutes, StringFormat='{}{0:0} min'}" Foreground="{ThemeResource SubtleBrush}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <TextBlock Text="Recent listening" FontSize="22" FontWeight="SemiBold" />
            <ListView x:Name="RecentList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SubtleBrush}"/></StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding HeardSeconds}" Foreground="{ThemeResource SubtleBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
