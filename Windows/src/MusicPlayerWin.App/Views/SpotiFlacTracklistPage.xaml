<Page
    x:Class="MusicPlayerWin.App.Views.SpotiFlacTracklistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="36,30,36,120">
        <StackPanel Spacing="20">
            <Button Content="‹ Back" Click="Back_Click" HorizontalAlignment="Left" />

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="220" Height="220" CornerRadius="16" Background="{ThemeResource PlaceholderBrush}">
                    <Image x:Name="Artwork" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="KindLabel" Foreground="{ThemeResource SubtleBrush}" />
                    <TextBlock x:Name="TitleText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText" FontSize="17" Foreground="{ThemeResource SubtleBrush}" />
                    <TextBlock x:Name="MetaText" Foreground="{ThemeResource SubtleBrush}" />
                    <TextBlock x:Name="DescriptionText" Foreground="{ThemeResource SubtleBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="3" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                        <Button x:Name="DownloadAllButton" Content="Download All" Click="DownloadAll_Click" IsEnabled="False" />
                        <Button x:Name="DownloadSelectedButton" Content="Download Selected" Click="DownloadSelected_Click" IsEnabled="False" />
                        <Button x:Name="SelectAllButton" Content="Select All" Click="SelectAll_Click" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="LoadingPanel" Spacing="10" HorizontalAlignment="Center" Padding="0,40">
                <ProgressRing IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingText" Text="Reading the track list…" Foreground="{ThemeResource SubtleBrush}" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="ErrorPanel" Spacing="10" HorizontalAlignment="Center" Padding="0,40" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                <Button Content="Try Again" Click="Retry_Click" HorizontalAlignment="Center" />
            </StackPanel>

            <ListView x:Name="FlatTracksList" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,7" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{ThemeResource SubtleBrush}" FontSize="12" Width="24" TextAlignment="Right" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Width="34" Height="34" CornerRadius="4" Background="{ThemeResource PlaceholderBrush}" Visibility="{Binding ShowCover}">
                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <Border Visibility="{Binding ExplicitVisibility}" Background="{ThemeResource SubtleBrush}" CornerRadius="2" Padding="3,0"><TextBlock Text="E" FontSize="9" /></Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{ThemeResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="4" Text="{Binding Album}" FontSize="11" Foreground="{ThemeResource SubtleBrush}" Width="200" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowAlbum}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="In library" FontSize="11" Foreground="{ThemeResource SubtleBrush}" Visibility="{Binding InLibraryVisibility}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="{Binding DurationText}" FontSize="12" Foreground="{ThemeResource SubtleBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ItemsControl x:Name="DiscographyList" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="10" Margin="0,0,0,26">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource PlaceholderBrush}">
                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{ThemeResource SubtleBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Tracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{ThemeResource SubtleBrush}" FontSize="12" Width="24" TextAlignment="Right" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{ThemeResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="In library" FontSize="11" Foreground="{ThemeResource SubtleBrush}" Visibility="{Binding InLibraryVisibility}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="12" Foreground="{ThemeResource SubtleBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="DownloadsPanel" Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="16" Padding="18" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold" />
                    <ListView x:Name="DownloadsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ProgressRing Grid.Column="0" IsActive="{Binding IsActive}" Width="16" Height="16" Visibility="{Binding ActiveVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{ThemeResource SubtleBrush}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
