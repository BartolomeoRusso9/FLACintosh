<Page
    x:Class="MusicPlayerWin.App.Views.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,28,32,110">
        <StackPanel Spacing="20">
            <TextBlock Text="Songs" FontSize="34" FontWeight="SemiBold" />
            <ListView x:Name="SongsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SongsList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D6;" Grid.Column="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Source.Key}" Foreground="{ThemeResource SubtleBrush}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Text="{Binding Artist}" Grid.Column="2" Foreground="{ThemeResource SubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Album}" Grid.Column="3" Foreground="{ThemeResource SubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Duration}" Grid.Column="4" Foreground="{ThemeResource SubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="14,0,0,0"><Button Content="Edit tags" Click="EditTags_Click"/><Button Content="Open folder" Click="OpenFolder_Click"/></StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Text="No songs in the library." Foreground="{ThemeResource SubtleBrush}" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
