<Page
    x:Class="MusicPlayerWin.App.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="36,30,36,120">
        <StackPanel Spacing="22">
            <Button Content="‹ Back" Click="Back_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="ArtistName" FontSize="36" FontWeight="SemiBold" />
            <TextBlock x:Name="Meta" Foreground="{ThemeResource SubtleBrush}" />
            <Button Content="Play artist" Click="Play_Click" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock Text="Albums" FontSize="24" FontWeight="SemiBold" />
            <ListView x:Name="AlbumsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Album_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Tracks.Count}" Foreground="{ThemeResource SubtleBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="{ThemeResource SubtleBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
