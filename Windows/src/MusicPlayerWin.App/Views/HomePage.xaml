<Page
    x:Class="MusicPlayerWin.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,28,32,32">
        <StackPanel Spacing="28">
            <StackPanel Spacing="4">
                <TextBlock Text="Home" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="Your music, ready to play." Foreground="{ThemeResource SubtleBrush}" FontSize="15" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ChooseFolderButton" Content="Choose music folder" Click="ChooseFolderButton_Click" />
                <Button Content="Play all" Click="PlayAllButton_Click" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Sources" FontSize="20" FontWeight="SemiBold" />
                <ListView x:Name="SourcesList" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <StackPanel Width="210"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource SubtleBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <ToggleSwitch IsOn="{Binding IsVisible}" Tag="{Binding Key}" Toggled="SourceVisibility_Toggled"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border Background="{ThemeResource PanelBackgroundBrush}" CornerRadius="18" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Library" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="LibrarySummary" Foreground="{ThemeResource SubtleBrush}" />
                    <ProgressBar x:Name="ScanProgress" Height="5" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="14">
                <TextBlock Text="Albums" FontSize="22" FontWeight="SemiBold" />
                <GridView x:Name="AlbumsGrid"
                          IsItemClickEnabled="True"
                          ItemClick="AlbumsGrid_ItemClick"
                          SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="6" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Margin="0,0,18,24" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="14" Padding="14">
                                <StackPanel Spacing="10">
                                    <Border Height="152" Background="{ThemeResource PlaceholderBrush}" CornerRadius="10">
                                        <Image Stretch="UniformToFill" Loaded="AlbumArtwork_Loaded" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Tracks.Count, FallbackValue=0}" Foreground="{ThemeResource SubtleBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock x:Name="EmptyState" Text="Choose a folder containing your music to populate the library." Foreground="{ThemeResource SubtleBrush}" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
