<UserControl
    x:Class="MusicPlayerWin.App.Controls.Scrubber"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="12">
    <Grid x:Name="RootGrid" Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          SizeChanged="RootGrid_SizeChanged">
        <Border x:Name="TrackBorder" Height="4" CornerRadius="2" Background="#1FFFFFFF" VerticalAlignment="Center" />
        <Border x:Name="FillBorder" Height="4" CornerRadius="2" Background="{ThemeResource BrandGradientBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
    </Grid>
</UserControl>
