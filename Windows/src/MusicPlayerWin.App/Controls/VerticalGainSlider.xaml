<UserControl
    x:Class="MusicPlayerWin.App.Controls.VerticalGainSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="26">
    <Grid x:Name="RootGrid" Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          DoubleTapped="RootGrid_DoubleTapped"
          SizeChanged="RootGrid_SizeChanged">
        <Border x:Name="TrackBorder" Width="4" CornerRadius="2" Background="#1FFFFFFF"
                HorizontalAlignment="Center" VerticalAlignment="Stretch" />
        <Border x:Name="FillBorder" Width="4" CornerRadius="2" Background="{ThemeResource BrandGradientBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Rectangle x:Name="CenterLine" Width="14" Height="1" Fill="#40FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                 HorizontalAlignment="Center" VerticalAlignment="Top">
            <Ellipse.Shadow>
                <ThemeShadow />
            </Ellipse.Shadow>
        </Ellipse>
    </Grid>
</UserControl>
