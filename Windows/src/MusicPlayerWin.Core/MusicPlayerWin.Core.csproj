<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately plain net8.0, not net8.0-windows: this project is the
         part worth testing, and it must stay runnable without a window —
         same reasoning as the SyncedLyrics target in the original
         Package.swift. Anything that needs WinRT/WinUI belongs in
         MusicPlayerWin.App instead. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MusicPlayerWin.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
